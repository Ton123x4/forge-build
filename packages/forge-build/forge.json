{
    "name": "forge-build",
    "type": "executable",
    "target": "bin/forge",
    "defines": {
        "windows": [ "_CRT_SECURE_NO_WARNINGS" ],
        "default": []
    },
    "includes": [
        "include"
    ],
    "sources": [
        "src"
    ],
    "flags": [
        "-std=c++20",
        "-Wall",
        "-Wno-c23-extensions"
    ],
    "requires": [
        "forge-core",
        "stdext"
    ]
}
